{
  "expo": {
    "name": "Rich记账",
    "slug": "rich-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-rich.png",
    "scheme": "richapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/rich-start.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.richapp.finance",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-rich-android-foreground.png",
        "backgroundColor": "#3FDEAE"
      },
      "package": "com.richapp.finance",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "web": {
      "favicon": "./assets/images/icon-rich.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
